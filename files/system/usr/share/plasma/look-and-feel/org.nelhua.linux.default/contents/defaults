# Applied to the user's KConfig when they (re-)select the Nelhua global
# theme. Paired with /etc/xdg/kdeglobals which sets BreezeDark as the
# system-wide default before any per-user state exists.

[Wallpaper]
Image=Nelhua

[kdeglobals][KDE]
LookAndFeelPackage=org.nelhua.linux.default
SingleClick=false

[kdeglobals][General]
ColorScheme=BreezeDark
AccentColor=184,117,220
LastUsedCustomAccentColor=184,117,220

[kdeglobals][Icons]
Theme=candy-icons

[kwinrc][org.kde.kdecoration2]
theme=Breeze
library=org.kde.breeze

[kwinrc][Plugins]
# Glass (kwin-effects-glass) replaces stock blur. See /etc/xdg/kwinrc
# for the rationale; this block reapplies that pairing when the user
# (re-)selects the Nelhua global theme in System Settings.
glassEnabled=true
blurEnabled=false
contrastEnabled=true

[kwinrc][Compositing]
OpenGLIsUnsafe=false
WindowsBlockCompositing=false

[plasmarc][Theme]
name=default

[ksplashrc][KSplash]
Theme=org.nelhua.linux.default

# When asset directories (contents/splash/, contents/loginmanager/,
# contents/lockscreen/, contents/wallpapers/) are populated, those are the
# pieces that make the theme visually distinct from Breeze. This defaults
# file controls the KConfig knobs; the QML/assets control the look.
