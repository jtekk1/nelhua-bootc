#!/usr/bin/env bash
# nelhua first-boot wizard — runs inside kitty fullscreen on first mango login
# (kicked off by /usr/libexec/nelhua/check-first-boot.sh from
# ~/.config/mango/config.conf's exec-once). KDE has no equivalent trigger yet.
#
# Uses gum (Charm) for prompts. Replaces the prior dialog-based implementation.
set -u

PRESET_ROOT="/usr/share/nelhua/presets/default"
WALLPAPER_DIR="/usr/share/backgrounds/nelhua"
DEFAULT_WALLPAPER="${WALLPAPER_DIR}/Nelhua-01.jpeg"
FLATPAK_LIST_FILE="/usr/share/nelhua/flatpaks.list"
FLATHUB_REPO_URL="https://dl.flathub.org/repo/flathub.flatpakrepo"
STATE_DIR="${HOME}/.config/nelhua"
MARKER="${STATE_DIR}/.setup-done"

mkdir -p "${STATE_DIR}"

# ---- styling helpers ----------------------------------------------------------

PINK=212
GREEN=82
YELLOW=214
RED=196

title() {
  gum style \
    --border double \
    --border-foreground "${PINK}" \
    --padding "0 2" \
    --margin "1 0" \
    --align center \
    --width 70 \
    "Nelhua Linux — First Boot" "$1"
}

info()  { gum style --foreground "${PINK}"   "$@"; }
ok()    { gum style --foreground "${GREEN}"  "$@"; }
warn()  { gum style --foreground "${YELLOW}" "$@"; }
fail()  { gum style --foreground "${RED}"    "$@"; }

# ---- 1. default preset --------------------------------------------------------

title "Welcome"
if gum confirm --default=true \
   "Install the default nelhua mango setup?

(waybar, wofi, mako, kanshi, swayidle/lock/osd, wlogout, kitty/foot,
fastfetch, GTK theming, tekktonic, and a wallpaper)"; then
  info "Installing default preset..."
  mkdir -p "${HOME}/.config"
  rsync -a "${PRESET_ROOT}/.config/" "${HOME}/.config/"

  # Substitute __HOME__ placeholder in any text config files
  grep -rlZ "__HOME__" "${HOME}/.config" 2>/dev/null \
    | xargs -0 -r sed -i "s|__HOME__|${HOME}|g"

  # Wire up the wallpaper symlink that mango's autostart.conf expects
  mkdir -p "${HOME}/.config/ThemeSwitcher"
  ln -sf "${DEFAULT_WALLPAPER}" "${HOME}/.config/ThemeSwitcher/wallpaper"

  ok "Default preset installed."
fi

# ---- 2. alternative shell (stub) ----------------------------------------------

title "Alternative Shell"
if gum confirm --default=false \
   "Install an alternative shell (noctalia or DankMaterialShell)?

(These would replace waybar/wofi/mako with a Quickshell-based bar.)"; then
  warn "Alternative shells are not yet wired up.
They will be fetched from upstream once support is added.
Skipping for now."
fi

# ---- 3. flatpaks --------------------------------------------------------------

title "System Flatpaks"

declare -a IDS=() LABELS=()
if [[ -r "${FLATPAK_LIST_FILE}" ]]; then
  while IFS='|' read -r id label; do
    [[ -z "${id}" || "${id}" =~ ^[[:space:]]*# ]] && continue
    IDS+=("${id}")
    LABELS+=("${label}")
  done < "${FLATPAK_LIST_FILE}"
fi

if (( ${#LABELS[@]} > 0 )); then
  # Pre-select all labels by default (matches the dialog version's "on" state)
  PRE="$(IFS=,; echo "${LABELS[*]}")"
  SELECTED_LABELS="$(printf '%s\n' "${LABELS[@]}" \
    | gum choose --no-limit \
                 --header "Select flatpaks to install (SPACE toggle, ENTER confirm). Uncheck anything you don't want. Make sure you're online." \
                 --selected="${PRE}" \
                 --cursor-prefix="[ ] " \
                 --selected-prefix="[x] " \
                 --unselected-prefix="[ ] " || true)"

  if [[ -n "${SELECTED_LABELS}" ]]; then
    # Map selected labels back to flatpak IDs
    declare -a SELECTED_IDS=()
    while IFS= read -r lbl; do
      [[ -z "${lbl}" ]] && continue
      for i in "${!LABELS[@]}"; do
        if [[ "${LABELS[$i]}" == "${lbl}" ]]; then
          SELECTED_IDS+=("${IDS[$i]}")
          break
        fi
      done
    done <<< "${SELECTED_LABELS}"

    info "Installing ${#SELECTED_IDS[@]} flatpak(s). You may be prompted for your password."
    echo
    sudo flatpak remote-add --system --if-not-exists flathub "${FLATHUB_REPO_URL}"
    sudo flatpak remote-modify --system --enable flathub
    sudo flatpak install --system --noninteractive --or-update flathub "${SELECTED_IDS[@]}"
    flatpak_rc=$?
    echo
    if (( flatpak_rc == 0 )); then
      ok "Installed ${#SELECTED_IDS[@]} flatpak(s) successfully."
    else
      fail "Some flatpaks failed to install (exit ${flatpak_rc}).
Retry individual ones later with:
  sudo flatpak install --system flathub <id>"
    fi
  fi
fi

touch "${MARKER}"

# ---- 4. done ------------------------------------------------------------------

title "Setup Complete"
info "Returning to the login screen so your new mango session picks up the settings."
sleep 2

# Kick the user back to tui-greet so the next mango session is fresh and
# loads the just-installed config. Without this, mango is left running with
# no terminal in front of it — symptom: black screen, no way to log in.
# Try a graceful session terminate first, fall back to killing mango itself.
if [[ -n "${XDG_SESSION_ID:-}" ]]; then
  loginctl terminate-session "${XDG_SESSION_ID}" 2>/dev/null || true
fi
pkill -KILL -u "${USER}" mango 2>/dev/null || true
