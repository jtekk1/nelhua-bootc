{
  // Tracks Containerfile FROM digests and GitHub Actions SHAs.
  // Replaces .github/dependabot.yml (which only covered github-actions).
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Sensible defaults: PR rate limit, scheduled grouping, semantic commits,
  // separate-major-minor for breaking changes, etc.
  "extends": [
    "config:best-practices",
  ],

  // Don't auto-rebase PRs when they conflict — leave that decision to us.
  "rebaseWhen": "never",

  "packageRules": [
    // Auto-merge any PR that just pins a moving tag to an immutable digest.
    // No semver bump, no behavior change — purely a reproducibility win.
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"],
    },

    // Hold Fedora bootc / Kinoite base images at the current major until the
    // next Fedora release actually ships. Bump the matchCurrentValue when
    // ready to move (e.g. "44" -> "45" once F45 stable releases). Rawhide
    // entries are unaffected because their tag is "rawhide", not "44".
    {
      "matchPackageNames": [
        "quay.io/fedora/fedora-bootc",
        "quay.io/fedora/fedora-kinoite",
      ],
      "matchCurrentValue": "44",
      "enabled": false,
    },

    // Ublue akmods pair — grouped so they bump together, never auto-merge.
    // The kernel-lock invariant (kmod version must match kinoite's shipped
    // kernel) means a naive Renovate bump can produce an unbootable image;
    // we manually verify the kernel version alignment before merging.
    {
      "matchPackageNames": [
        "ghcr.io/ublue-os/akmods",
        "ghcr.io/ublue-os/akmods-nvidia-open",
      ],
      "groupName": "ublue akmods",
      "automerge": false,
    },
  ],

  // Custom regex managers — pick up out-of-band pins inside build.sh that
  // aren't surfaced by Containerfile/Actions defaults. Each annotation
  // immediately precedes the line being pinned; the regex captures the
  // value via the (?<currentValue>...) or (?<currentDigest>...) group.
  //
  // Pattern:
  //   # renovate: datasource=<ds> depName=<repo> [branch=<branch>]
  //   local (sha|tag)="<value>"
  //
  // The managers below differ only by datasource — git-refs captures a
  // currentDigest, github-releases/gitlab-tags capture a currentValue.
  "customManagers": [
    // candy-icons (PR #13). Tracks master HEAD via git-refs → SHA digest.
    {
      "customType": "regex",
      "managerFilePatterns": ["^build_files/build\\.sh$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\s*\\n\\s*local sha=\"(?<currentDigest>[0-9a-f]+)\"",
      ],
    },

    // superfile (PR #15). Tracks GitHub releases → version tag.
    {
      "customType": "regex",
      "managerFilePatterns": ["^build_files/build\\.sh$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>\\S+)\\s*\\n\\s*local tag=\"(?<currentValue>[^\"]+)\"",
      ],
    },

    // BeautyLine via Garuda Linux's GitLab fork (PR #21). Original
    // store.kde.org author (1425426) has no public repo; gvolpe/BeautyLine
    // on GitHub is stale; Garuda's gitlab fork is the actively-tagged
    // source. gitlab-tags datasource defaults to gitlab.com so no
    // registryUrl capture is needed.
    {
      "customType": "regex",
      "managerFilePatterns": ["^build_files/build\\.sh$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>gitlab-tags) depName=(?<depName>\\S+)\\s*\\n\\s*local tag=\"(?<currentValue>[^\"]+)\"",
      ],
    },

    // chunkah container image pin in the build workflow (PR #25). The
    // pin lives inside a `run:` block as `CHUNKAH_IMAGE: "quay.io/coreos/
    // chunkah:vX.Y.Z"`, which the default github-actions manager doesn't
    // touch (it only looks at `uses:` references). chunkah is pre-1.0,
    // so a tag pin is fine — bumps will surface as PRs we read before
    // merging.
    {
      "customType": "regex",
      "managerFilePatterns": ["^\\.github/workflows/build\\.yml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\s*\\n\\s*env:\\s*\\n\\s*CHUNKAH_IMAGE: \"[^:]+:(?<currentValue>v[^\"]+)\"",
      ],
    },

    // Ublue akmods + akmods-nvidia-open kernel-module images used by the
    // kde-nvidia-open flavor. Pins live as ARG defaults in
    // Containerfile.nvidia-open — Renovate's default Dockerfile manager
    // does NOT resolve `FROM $IMG:${ARG}` back to the ARG line, so we
    // point a regex manager at the ARG lines directly.
    //
    // Both tags MUST bump together and MUST match the base image's
    // shipped kernel exactly (kmod ABI is kernel-version-locked). A
    // stray bump alone would produce an unbootable image — see the
    // packageRule below that groups + disables auto-merge for this pair.
    {
      "customType": "regex",
      "managerFilePatterns": ["^Containerfile\\.nvidia-open$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\s*\\nARG \\S+=(?<currentValue>\\S+)",
      ],
      "versioningTemplate": "loose",
    },
  ],
}

